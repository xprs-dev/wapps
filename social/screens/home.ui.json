[
  {
    "$": "screen",
    "name": "Activity",
    "icon": "home",
    "tip": "Statuses heard over the air. Share one below -- it goes out on every radio this device has.",
    "children": [
      {
        "$": "field",
        "name": "activity",
        "$type": "chat",
        "hint": "What's happening?"
      },
      {
        "$": "action",
        "name": "clear_feed",
        "label": "Clear feed",
        "icon": "delete",
        "slot": "menu",
        "tip": "Remove all posts currently in the feed"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Search",
    "icon": "search",
    "menu": true,
    "appbar": true,
    "tip": "Search the statuses this station archived, by words or by callsign.",
    "children": [
      {
        "$": "field",
        "name": "search_input",
        "$type": "string",
        "label": "Search",
        "hint": "Words, or a callsign",
        "live": true
      },
      {
        "$": "field",
        "name": "search_kind",
        "$type": "enum",
        "label": "Find",
        "default": "all",
        "apply": "search_kind_changed",
        "children": [
          {
            "$": "option",
            "name": "all",
            "label": "Everything"
          },
          {
            "$": "option",
            "name": "posts",
            "label": "Posts"
          },
          {
            "$": "option",
            "name": "people",
            "label": "People"
          }
        ]
      },
      {
        "$": "field",
        "name": "search_when",
        "$type": "enum",
        "label": "When",
        "default": "any",
        "apply": "search_when_changed",
        "children": [
          {
            "$": "option",
            "name": "any",
            "label": "Any time"
          },
          {
            "$": "option",
            "name": "day",
            "label": "24 hours"
          },
          {
            "$": "option",
            "name": "week",
            "label": "Week"
          },
          {
            "$": "option",
            "name": "month",
            "label": "Month"
          }
        ]
      },
      {
        "$": "field",
        "name": "search_results",
        "$type": "chat"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Following",
    "icon": "people",
    "menu": true,
    "tip": "Callsigns you follow. The Following tab narrows the feed to them.",
    "children": [
      {
        "$": "action",
        "name": "follow_add",
        "label": "Follow a callsign",
        "icon": "person_add",
        "style": "primary",
        "tip": "Type a callsign to follow -- their statuses appear under Following."
      },
      {
        "$": "field",
        "name": "follow_input",
        "$type": "string",
        "label": "Callsign",
        "hint": "X1ABCD"
      },
      {
        "$": "field",
        "name": "follows_list",
        "$type": "people",
        "tip": "Callsigns you follow. Tap a row to open it."
      }
    ],
    "toolbar": true
  }
]
