{
  "id":              "tools.xprs.maps",
  "version":         "1.0.2",
  "kind":            "app",
  "title":           "Maps",
  "description":     "Satellite maps with offline tile cache.",
  "summary":         "Browse satellite imagery with pan/zoom. Tiles are cached locally for offline use, so previously visited areas remain available without a network connection.",
  "icon":            "media/icons/map.svg",
  "tags":            ["maps", "satellite", "gps", "tools"],
  "entry_ui":        "screens/home.ui.json",
  "tick_interval_ms": 1000,
  "permissions":     ["network", "storage"],
  "provides": {
    "functions": [],
    "events":    ["viewport.changed"],
    "variables": ["center_lat", "center_lon", "zoom"]
  },
  "requires": {
    "hal":       ["log", "kv", "msg", "platform"],
    "events":    [],
    "libraries": [],
    "variables": []
  }
}
