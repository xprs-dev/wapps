[
  {
    "$": "screen",
    "name": "Indexer",
    "icon": "hub",
    "tip": "An indexer tells the network which devices hold the posts and files of each npub. It stores addresses, never the content.",
    "children": [
      {
        "$": "field",
        "name": "enabled",
        "$type": "bool",
        "label": "Enable",
        "default": false,
        "apply": "enabled_changed"
      },
      {
        "$": "field",
        "name": "dashboard",
        "$type": "stats"
      },
      {
        "$": "field",
        "name": "plugged",
        "$type": "bool",
        "label": "Only when plugged in",
        "default": true,
        "apply": "plugged_changed"
      }
    ]
  }
]
